// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  RECRUITER
  BUYER
  ADMIN
}

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskClaimStatus {
  CLAIMED
  SUBMITTED
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String
  role      UserRole @default(LEARNER)
  headline  String?
  skills    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskClaims TaskClaim[]

  @@index([email])
  @@index([role])
}

model Project {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String           @db.Text
  techStack   String[]         @default([])
  githubOrg   String
  githubRepo  String
  difficulty  ProjectDifficulty @default(BEGINNER)
  status      ProjectStatus    @default(ACTIVE)
  tags        String[]         @default([])
  featured    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tasks Task[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([techStack])
}

model Task {
  id                String        @id @default(cuid())
  projectId         String
  title             String
  description       String        @db.Text
  githubIssueNumber Int?
  status            TaskStatus    @default(OPEN)
  difficulty        TaskDifficulty @default(EASY)
  tags              String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskClaims TaskClaim[]

  @@index([projectId])
  @@index([status])
  @@index([difficulty])
}

model TaskClaim {
  id                   String          @id @default(cuid())
  taskId               String
  learnerId            String
  status               TaskClaimStatus @default(CLAIMED)
  githubPullRequestUrl String?
  reviewNotes          String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  learner User   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([learnerId])
  @@index([status])
  @@unique([taskId, learnerId])
}

